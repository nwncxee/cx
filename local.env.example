# Copy to local.env (gitignored) and set what your machine needs; the environment overrides this file.
# tools/paths.py resolves every key; anything left unset falls back to the default named beside it.
# A git worktree without its own local.env reads the main checkout's.

# The game install. Default: found in your Steam libraries.
#NWN_DIR=~/.local/share/Steam/steamapps/common/Neverwinter Nights
# The Linux / Windows client binaries. Default: under NWN_DIR.
#NWN_BIN=
#NWN_WIN_EXE=

# The read-only decompile dump (tools/ghidra/decomp-all.sh writes it). Default: ~/nwn-decomp
#NWN_DECOMP=~/nwn-decomp
# The Ghidra project directory holding nwn-linux.rep and nwn-win.rep (CLAUDE.md, Reverse engineering).
#GHIDRA_PROJECT=~/ghidra
# The Ghidra install, the directory holding support/analyzeHeadless. Default: found from the ghidra on PATH.
#GHIDRA=/opt/ghidra

# Content the offline tools check against (all optional; a tool that needs one says so).
#CONTENT_SHADERS=        a directory of content .shd files, spliced by check-shaders.py
#CONTENT_MODELS=         a directory tree of .mdl files (tools/mdlcheck ascii/fuzz)
# NeverBlender's decompiler for binary models. Default: next to this repo.
#NEVERBLENDER=../neverblender/NeverBlender

# build-win.sh / build-win-native.sh: a Windows 10 SDK and an MSVC tool tree. No default.
# On Linux, `nix develop .#win` sets SDK, SDKVER and MSVC for you; set these only to use your own copy.
#SDK=/mnt/c/Program Files (x86)/Windows Kits/10
#MSVC=/mnt/c/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.35.32215

# tools/release/sign.sh: the private release-signing key (ssh-keygen ed25519). Default: ~/.ssh/cx-release
#RELEASE_SIGN_KEY=~/.ssh/cx-release
