#!/usr/bin/env python3
"""The one seam between this project and Plane (ADR-0054).

Every call to Plane's REST API goes through `Plane` below. The importer, the
pull-request bridge and the agent command surface are all thin callers of it,
because the mapping decisions -- how a `Priority/*` label becomes a priority,
how a Gitea issue number survives as a legacy reference, what "blocked" means
-- have to be identical in all three, and one module is the only way to be sure
they are.

Configuration comes from the environment:

    PLANE_BASE_URL    e.g. https://plane.example -- no trailing slash
    PLANE_WORKSPACE   the workspace slug
    PLANE_API_KEY     a workspace API key, sent as X-API-Key

The base URL and the workspace have working defaults, so a new developer sets
only PLANE_API_KEY. When the environment is bare the values are read from a
personal config file instead.

Only the standard library is used, and the shebang is plain python3: this runs
from a checkout, on a server, and out of any repository, and none of those
places wants a dependency set or a development shell to keep in step.

The source is sow-platform's `infra/nixos/scripts/plane.py`. Every other
repository carries a byte-identical copy at `bin/plane` (ADR-0060). Fix a bug
at the source: when it lands on main, the sync-plane-client workflow opens a
pull request replacing the copy in every other repository (ADR-0062).

Run `bin/plane --help` for the command surface.
"""

from __future__ import annotations

import argparse
import hashlib
import html
import html.parser
import json
import mimetypes
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import time
import urllib.request
import uuid

# --- mapping ---------------------------------------------------------------

# Priority stops being a label and becomes the native field. Carrying the
# labels across as well would leave two sources of truth for one fact, which is
# the whole reason for the move.
PRIORITY_BY_LABEL = {
    "Priority/Critical": "urgent",
    "Priority/High": "high",
    "Priority/Medium": "medium",
    "Priority/Low": "low",
}
NO_PRIORITY = "none"

# Where a migrated work item records the issue it came from. Plane matches on
# the pair, so the source name is what makes a re-run an update instead of a
# duplicate.
EXTERNAL_SOURCE = "gitea"

# The org every repository lives under, so `sow-platform#341` means the same as
# `ShadowsOverWestgate/sow-platform#341`.
LEGACY_OWNER = "ShadowsOverWestgate"

# Plane answers 429 with no `Retry-After`, so the wait is ours to choose: five
# seconds, doubling, capped at a minute. Six tries covers a window of about two
# minutes, which is longer than any throttle this instance applies.
# A throttle answers 429; a gateway in front of Plane answers 502, 503 or 504
# while the service behind it is still fine. Both are worth waiting out rather
# than losing the run, but only a call that is safe to repeat is repeated.
RETRY_STATUSES = (429, 502, 503, 504)

RATE_LIMIT_RETRIES = 6
RATE_LIMIT_BACKOFF = 5
RATE_LIMIT_CEILING = 60

# Where a developer's own credentials live when the environment does not carry
# them. Every member mints a personal API key from their tracker profile, so
# day-to-day use needs no shared credential.
# What a checkout knows without being told. Only the key is personal, so this is
# the difference between "mint a token" and "mint a token and find two strings".
# Override either one from the environment to point at another instance.
DEFAULTS = {
    "PLANE_BASE_URL": "https://plane.westgate.pw",
    "PLANE_WORKSPACE": "shadows-over-westgate",
}

CONFIG_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "sow",
    "plane.env",
)


def config_file_values(path=None):
    """`KEY=VALUE` lines from the personal config file. No file means no values."""
    try:
        with open(path or CONFIG_FILE, encoding="utf-8") as handle:
            text = handle.read()
    except OSError:
        return {}
    values = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        values[key.strip()] = value.strip().strip("\"'")
    return values


# The default `Python-urllib/3.13` agent is refused with a 403 before the
# request reaches Plane; any named agent passes. So every call says who it is,
# which is worth doing anyway when 754 work items arrive at once and somebody
# is reading the access log wondering what did that.
USER_AGENT = "sow-plane-client"

# A state belongs to one of Plane's five groups. These two are the closed ones;
# everything else is open, including backlog.
CLOSED_GROUPS = frozenset({"completed", "cancelled"})

# `Closes SOW-12`, `fixes sow-12`, `Resolved: PLAT-3` -- the explicit half of
# what Gitea used to do for free. Only these close anything; a bare mention
# does not, and that loss is accepted in ADR-0054.
CLOSING_REFERENCE = re.compile(
    r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\b[:\s]+([A-Za-z][A-Za-z0-9]*)-(\d+)\b",
    re.IGNORECASE,
)

WORK_ITEM_REFERENCE = re.compile(r"^([A-Za-z][A-Za-z0-9]*)-(\d+)$")

LEGACY_REFERENCE = re.compile(r"^(?:([\w.-]+)/)?([\w.-]+)#(\d+)$")


PRIORITIES = ["none", "low", "medium", "high", "urgent"]


def priority_for_labels(labels):
    """The Plane priority a Gitea issue's labels map to.

    At most one `Priority/*` label is allowed by the label policy; if several
    arrive anyway the most urgent wins, because under-stating an urgent issue
    is the worse failure.
    """
    order = ["urgent", "high", "medium", "low"]
    found = [PRIORITY_BY_LABEL[name] for name in labels if name in PRIORITY_BY_LABEL]
    for priority in order:
        if priority in found:
            return priority
    return NO_PRIORITY


def labels_to_carry(labels):
    """The labels that survive the move: everything that is not a priority."""
    return [name for name in labels if name not in PRIORITY_BY_LABEL]


def split_labels(values):
    """Every label named by `--label` values, repeated or comma-separated."""
    return [name.strip() for value in values for name in value.split(",") if name.strip()]


def closing_references(text):
    """Every `Closes PROJ-123` in a pull request body, in order, deduplicated."""
    seen = []
    for identifier, sequence in CLOSING_REFERENCE.findall(text or ""):
        reference = f"{identifier.upper()}-{int(sequence)}"
        if reference not in seen:
            seen.append(reference)
    return seen


def parse_reference(reference):
    """`PROJ-123` -> ("PROJ", 123). Raises ValueError on anything else."""
    match = WORK_ITEM_REFERENCE.match(reference.strip())
    if not match:
        raise ValueError(f"not a work item reference: {reference!r}")
    return match.group(1).upper(), int(match.group(2))


def legacy_reference(owner, repo, number):
    """How a migrated item records where it came from: `owner/repo#number`."""
    return f"{owner}/{repo}#{number}"


def legacy_external_id(argument):
    """`sow-platform#341` -> the external id its item was imported under.

    None means it is not a Gitea reference, so it is a `PROJ-N` or nothing.
    Old tickets, commits and pull requests still cite issues this way, and the
    number should keep working rather than send someone to an index.
    """
    match = LEGACY_REFERENCE.match(argument.strip())
    if not match:
        return None
    owner, repo, number = match.groups()
    return legacy_reference(owner or LEGACY_OWNER, repo, int(number))


def find_items(items, text):
    """The items whose title contains `text`, ignoring case."""
    needle = text.lower()
    return [item for item in items if needle in (item.get("name") or "").lower()]


def find_lines(identifier, items, text, states_by_id):
    """What `find` prints: `PROJ-N  state  title`, one line per match."""
    lines = []
    for item in find_items(items, text):
        state = states_by_id.get(str(item.get("state")), {}).get("name", "")
        lines.append(f"{identifier}-{item['sequence_id']}  {state}  {item.get('name') or ''}")
    return lines


def is_open(work_item, states_by_id):
    """Open means: its state is not in a completed or cancelled group."""
    state = states_by_id.get(str(work_item.get("state")))
    if state is None:
        return True
    return state.get("group") not in CLOSED_GROUPS


def frontier(children, relations_by_item, states_by_id, open_outside=()):
    """Open children, unassigned, with no open blocker.

    This is the star chart's "what can be picked up right now". It is a pure
    function of what the caller has already fetched so that the same rule can
    be asserted without a live instance. `open_outside` holds the ids of open
    blockers that are not children: star charts block each other across projects, and
    a child waiting on one is not ready.
    """
    open_ids = {str(c["id"]) for c in children if is_open(c, states_by_id)}
    blocking_ids = open_ids | {str(i) for i in open_outside}
    ready = []
    for child in children:
        if str(child["id"]) not in open_ids:
            continue
        if child.get("assignees"):
            continue
        blockers = relations_by_item.get(str(child["id"]), {}).get("blocked_by", [])
        if any(str(b["issue_id"]) in blocking_ids for b in blockers):
            continue
        ready.append(child)
    return ready


def child_lines(children, relations_by_item, states_by_id, labels_by_id, members_by_id,
                reference_by_id):
    """What `children` and `frontier` print, one line per item, by sequence.

    `PROJ-N  state  type  assignees  title`, then `blocked by ...` naming the
    open blockers. A blocker among the children counts while it is open. One
    outside them arrives already judged: the caller fetched it and put its
    reference in `reference_by_id` only if it was open, since its state lives
    in a project whose states this function never sees.
    """
    child_ids = {str(c["id"]) for c in children}
    open_ids = {str(c["id"]) for c in children if is_open(c, states_by_id)}
    lines = []
    for child in sorted(children, key=lambda c: c.get("sequence_id") or 0):
        item_id = str(child["id"])
        state = states_by_id.get(str(child.get("state")), {}).get("name", "")
        kinds = [
            labels_by_id.get(str(label), {}).get("name", "") for label in child.get("labels") or []
        ]
        kind = next((k.split(":", 1)[1] for k in kinds if k.startswith("starchart:")), "-")
        who = ", ".join(members_by_id.get(str(a), str(a)) for a in child.get("assignees") or [])
        line = f"{reference_by_id.get(item_id, item_id)}  {state}  {kind}  {who or '-'}  "
        line += child.get("name") or ""
        blockers = []
        for blocker in relations_by_item.get(item_id, {}).get("blocked_by", []):
            blocker_id = str(blocker["issue_id"])
            if blocker_id in child_ids:
                if blocker_id in open_ids:
                    blockers.append(reference_by_id.get(blocker_id, blocker_id))
            elif blocker_id in reference_by_id:
                blockers.append(reference_by_id[blocker_id])
        lines.append(f"{line}  blocked by {', '.join(blockers)}" if blockers else line)
    return lines


def summary(verb, reference, item, tail=""):
    """What a write says it did: `closed PLAT-12 Title`, one line.

    The whole object is noise to an agent that only needs to know the write
    landed and on which item; `--json` still hands it over for a script.
    """
    identifier, sequence = parse_reference(reference)
    line = f"{verb} {identifier}-{sequence} {item.get('name') or ''}".rstrip()
    return f"{line} {tail}" if tail else line


def user_line(user):
    """A user as `display_name id`. The id is what `file --assignee` takes."""
    return f"{user.get('display_name')} {user['id']}"


# --- reading a thread --------------------------------------------------------

# Tags that live inside a line. Everything else is a block, and a block this
# converter has no rule for still prints its text: an unknown tag loses its
# markup, never its words.
INLINE_TAGS = frozenset({
    "a", "abbr", "b", "br", "code", "del", "em", "i", "img", "input", "mark", "s",
    "small", "span", "strike", "strong", "sub", "sup", "u",
})
VOID_TAGS = frozenset({"br", "hr", "img", "input", "meta", "link", "col", "wbr"})


class _Node:
    """One element of a parsed body: its tag, attributes and children."""

    def __init__(self, tag, attrs):
        self.tag, self.attrs, self.children = tag, dict(attrs), []


class _Tree(html.parser.HTMLParser):
    """Stored HTML as a tree. Entities arrive decoded, since `convert_charrefs`
    is on; a stray close tag is ignored rather than trusted."""

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.root = _Node("root", [])
        self.stack = [self.root]

    def handle_starttag(self, tag, attrs):
        node = _Node(tag, attrs)
        self.stack[-1].children.append(node)
        if tag not in VOID_TAGS:
            self.stack.append(node)

    def handle_endtag(self, tag):
        for depth in range(len(self.stack) - 1, 0, -1):
            if self.stack[depth].tag == tag:
                del self.stack[depth:]
                return

    def handle_data(self, data):
        self.stack[-1].children.append(data)


def html_to_markdown(html_text, base_url, workspace):
    """A stored body as the Markdown subset an agent writes (PLAT-272).

    Headings, paragraphs, lists one level deep and deeper, code, bold, italic,
    links and tables. A link to a work item comes back as `name (PROJ-N)`, or
    the bare reference when that is its whole text. No wrapping: a line is as
    long as its paragraph.
    """
    item_link = re.compile(
        re.escape(f"{base_url}/{workspace}/browse/") + r"([A-Za-z][A-Za-z0-9]*-\d+)/?$"
    )

    def text_of(node):
        if isinstance(node, str):
            return node
        return "".join(text_of(child) for child in node.children)

    def inline(nodes):
        out = []
        for node in nodes:
            if isinstance(node, str):
                out.append(re.sub(r"\s+", " ", node))
                continue
            inner = inline(node.children)
            if node.tag == "br":
                out.append("\n")
            elif node.tag in ("strong", "b"):
                out.append(f"**{inner}**")
            elif node.tag in ("em", "i"):
                out.append(f"*{inner}*")
            elif node.tag == "code":
                out.append(f"`{text_of(node)}`")
            elif node.tag == "a":
                href = node.attrs.get("href") or ""
                found = item_link.match(href)
                if found:
                    reference = found.group(1)
                    out.append(reference if inner.strip() == reference else f"{inner} ({reference})")
                else:
                    out.append(f"[{inner}]({href})" if href else inner)
            else:
                out.append(inner)
        # A `<br>` keeps its break; the spaces around it are the source's layout.
        return re.sub(r" *\n *", "\n", "".join(out)).strip(" ")

    def list_lines(node, depth):
        lines, pad = [], "  " * depth
        for number, item in enumerate(
            (c for c in node.children if isinstance(c, _Node) and c.tag == "li"), 1
        ):
            marker = f"{number}." if node.tag == "ol" else "-"
            checked = item.attrs.get("data-checked")
            if checked is not None:
                marker += " [x]" if checked == "true" else " [ ]"
            nested = [c for c in item.children if isinstance(c, _Node) and c.tag in ("ul", "ol")]
            # Tiptap wraps an item's words in `<p>`; a second paragraph or a
            # `<br>` continues the item on an indented line.
            text = "\n".join(blocks([c for c in item.children if c not in nested]))
            text = text.replace("\n\n", "\n").replace("\n", "\n" + pad + "  ")
            lines.append(f"{pad}{marker} {text}".rstrip())
            for child in nested:
                lines.extend(list_lines(child, depth + 1))
        return lines

    def table(node):
        rows = []

        def walk(parent):
            for child in parent.children:
                if isinstance(child, _Node):
                    if child.tag == "tr":
                        cells = [c for c in child.children if isinstance(c, _Node)]
                        rows.append(["\n".join(blocks(c.children)).replace("\n", " ") for c in cells])
                    else:
                        walk(child)

        walk(node)
        lines = [f"| {' | '.join(row)} |" for row in rows]
        if lines:
            lines.insert(1, f"| {' | '.join('---' for _ in rows[0])} |")
        return "\n".join(lines)

    def blocks(nodes):
        out, run = [], []

        def flush():
            text = inline(run)
            if text.strip():
                out.append(text)
            run.clear()

        for node in nodes:
            if isinstance(node, str) or node.tag in INLINE_TAGS:
                run.append(node)
                continue
            flush()
            tag = node.tag
            if re.fullmatch(r"h[1-6]", tag):
                out.append("#" * int(tag[1]) + " " + inline(node.children))
            elif tag in ("ul", "ol"):
                out.append("\n".join(list_lines(node, 0)))
            elif tag == "pre":
                code = next((c for c in node.children if isinstance(c, _Node) and c.tag == "code"), node)
                language = next(
                    (k[len("language-"):] for k in (code.attrs.get("class") or "").split()
                     if k.startswith("language-")),
                    "",
                )
                out.append(f"```{language}\n{text_of(code).rstrip(chr(10))}\n```")
            elif tag == "hr":
                out.append("---")
            elif tag == "table":
                out.append(table(node))
            else:
                out.extend(blocks(node.children))
        flush()
        return [block for block in out if block.strip()]

    parser = _Tree()
    parser.feed(html_text or "")
    parser.close()
    return "\n\n".join(blocks(parser.root.children))


# --- writing a body ----------------------------------------------------------

# A link may point at the web, somewhere relative, or an address. Anything else
# -- `javascript:` above all -- is code that runs for whoever clicks it, so the
# link is written out as the text it was instead.
LINK_SCHEMES = ("http:", "https:", "mailto:")

# One pass over a line, leftmost match first. Code and links come before a bare
# reference in the alternation, which is what keeps `GAME-12` a sample inside
# backticks and plain text inside a link someone already wrote. A reference is
# not one after a slash, so a URL typed out in prose is left whole; a leading
# zero rules out `ADR-0054`, which no work item number has.
INLINE_MARKDOWN = re.compile(
    r"`(?P<code>[^`]+)`"
    r"|\[(?P<text>[^\]]+)\]\((?P<href>[^)\s]+)\)"
    r"|\*\*(?P<bold>.+?)\*\*"
    r"|\*(?P<em>[^*\s](?:[^*]*[^*\s])?)\*"
    r"|(?<![\w/-])(?P<ref>[A-Z][A-Z0-9]*-[1-9]\d*)\b"
)
FENCE = re.compile(r"^```\s*([\w+#.-]*)\s*$")
HEADING = re.compile(r"^(#{1,6})\s+(.*)$")
RULE = re.compile(r"^-{3,}\s*$")
LIST_ITEM = re.compile(r"^( *)(-|\d+\.)\s+(.*)$")
TABLE_SEPARATOR = re.compile(r"^\|?(\s*:?-+:?\s*\|)*\s*:?-+:?\s*\|?$")


def _safe_href(url):
    lowered = url.strip().lower()
    return ":" not in lowered.split("/")[0] or lowered.startswith(LINK_SCHEMES)


def markdown_to_html(text, base_url, workspace, identifiers=None):
    """Markdown in PLAT-272's subset as the HTML Plane's editor stores.

    The tags are the shapes `html_to_markdown` reads, so a body survives the
    trip out and back. Everything that is not markup this writes is escaped
    text. A bare `GAME-12` becomes a link to its item; `identifiers` is the
    workspace's project list, so an `SHA-256` in prose stays prose. Without it
    any upper-case `WORD-N` counts.
    """
    item_url = f"{base_url}/{workspace}/browse/"

    def inline(line, references=True):
        out, at = [], 0
        for match in INLINE_MARKDOWN.finditer(line):
            out.append(html.escape(line[at:match.start()], quote=False))
            at = match.end()
            part = match.groupdict()
            if part["code"] is not None:
                out.append(f"<code>{html.escape(part['code'], quote=False)}</code>")
            elif part["href"] is not None:
                if _safe_href(part["href"]):
                    words = inline(part["text"], references=False)
                    out.append(f'<a href="{html.escape(part["href"])}">{words}</a>')
                else:
                    out.append(html.escape(match.group(0), quote=False))
            elif part["bold"] is not None:
                out.append(f"<strong>{inline(part['bold'], references)}</strong>")
            elif part["em"] is not None:
                out.append(f"<em>{inline(part['em'], references)}</em>")
            else:
                ref = part["ref"]
                known = identifiers is None or ref.split("-")[0] in identifiers
                out.append(f'<a href="{item_url}{ref}/">{ref}</a>' if references and known else ref)
        out.append(html.escape(line[at:], quote=False))
        return "".join(out)

    def starts_block(line):
        return bool(
            FENCE.match(line) or HEADING.match(line) or RULE.match(line)
            or LIST_ITEM.match(line) or line.lstrip().startswith("|")
        )

    def cells(line):
        return [cell.strip() for cell in line.strip().strip("|").split("|")]

    def list_html(entries):
        out, open_tag = [], None
        for entry in entries:
            if entry[0] != open_tag:
                out.append(f"</{open_tag}><{entry[0]}>" if open_tag else f"<{entry[0]}>")
                open_tag = entry[0]
            # Tiptap wraps an item's words in `<p>`, and so does this.
            nested = list_html(entry[2]) if len(entry) > 2 and entry[2] else ""
            out.append(f"<li><p>{inline(entry[1])}</p>{nested}</li>")
        out.append(f"</{open_tag}>")
        return "".join(out)

    lines = (text or "").replace("\r\n", "\n").split("\n")
    out, i = [], 0
    while i < len(lines):
        line = lines[i]
        if not line.strip():
            i += 1
            continue
        fence, heading = FENCE.match(line), HEADING.match(line)
        if fence:
            end = i + 1
            while end < len(lines) and lines[end].strip() != "```":
                end += 1
            language = fence.group(1)
            kind = f' class="language-{html.escape(language)}"' if language else ""
            code = html.escape("\n".join(lines[i + 1:end]), quote=False)
            out.append(f"<pre><code{kind}>{code}</code></pre>")
            i = end + 1
        elif heading:
            level = len(heading.group(1))
            out.append(f"<h{level}>{inline(heading.group(2).strip())}</h{level}>")
            i += 1
        elif RULE.match(line):
            out.append("<hr />")
            i += 1
        elif line.lstrip().startswith("|"):
            rows = []
            while i < len(lines) and lines[i].lstrip().startswith("|"):
                rows.append(lines[i])
                i += 1
            header = len(rows) > 1 and TABLE_SEPARATOR.match(rows[1].strip())
            body = []
            for number, row in enumerate(rows):
                if header and number == 1:
                    continue
                tag = "th" if header and number == 0 else "td"
                body.append("<tr>" + "".join(
                    f"<{tag}><p>{inline(cell)}</p></{tag}>" for cell in cells(row)
                ) + "</tr>")
            out.append(f"<table><tbody>{''.join(body)}</tbody></table>")
        elif LIST_ITEM.match(line):
            # One level of nesting: two spaces or more puts an item under the
            # one before it. A plain line continues the last item.
            items = []
            while i < len(lines) and lines[i].strip():
                item = LIST_ITEM.match(lines[i])
                if item:
                    entry = ["ol" if item.group(2)[0].isdigit() else "ul", item.group(3), []]
                    if len(item.group(1)) >= 2 and items:
                        items[-1][2].append(entry)
                    else:
                        items.append(entry)
                elif starts_block(lines[i]):
                    break
                else:
                    last = items[-1][2][-1] if items[-1][2] else items[-1]
                    last[1] += " " + lines[i].strip()
                i += 1
            out.append(list_html(items))
        else:
            # A paragraph's lines join until a blank line, or until a list,
            # heading, fence or table starts: "Steps:" and then a list is one
            # thought an agent writes without a blank line between.
            words = [line.strip()]
            i += 1
            while i < len(lines) and lines[i].strip() and not starts_block(lines[i]):
                words.append(lines[i].strip())
                i += 1
            out.append(f"<p>{inline(' '.join(words))}</p>")
    return "".join(out) or "<p></p>"


def normalize_html(html_text):
    """A stored body with the editor's rewrites taken out.

    Plane never hands back what it was given: it wraps the body in a `<div>`,
    adds `rel` to every link, writes `<hr>` for `<hr />`, and may lay blocks
    out on lines of their own. None of that is anybody's edit. Only whitespace
    that spans a line is dropped between tags; a space between two inline
    tags is a word break.
    """
    text = re.sub(r">\s*\n\s*<", "><", (html_text or "").strip())
    text = re.sub(r'\s+rel="[^"]*"', "", text)
    text = re.sub(r"<hr\s*/?>", "<hr>", text)
    if text.startswith("<div>") and text.endswith("</div>"):
        text = text[len("<div>"):-len("</div>")]
    return text


def body_token(html_text):
    """What `show` prints as `body:` and `edit --expect` checks: a short hash
    of the normalised body. Same body, same token, whoever last saved it."""
    return hashlib.sha256(normalize_html(html_text).encode()).hexdigest()[:12]


# --- indexing a decision on its star chart ---------------------------------

DECISIONS = "decisions"


def decision_line(name, item_url, gist, base_url, workspace, identifiers=None):
    """The `<li>` `resolve` adds to a star chart: `- [name](url) — gist` (PLAT-273).

    The gist goes through the same inline Markdown as a body. It is written as
    a list item's text, so a gist that starts with `#` or `-` stays words.
    The link leads the line because `append_decision` tells a chart's own line
    for an item from a mention of it by that (PLAT-290).
    """
    gist = " ".join((gist or "").split())
    item = markdown_to_html(f"- {gist}", base_url, workspace, identifiers)
    words = item[len("<ul><li><p>"):-len("</p></li></ul>")]
    link = f'<a href="{html.escape(item_url)}">{html.escape(name, quote=False)}</a>'
    return f"<li><p>{link} — {words}</p></li>"


class _Tags(html.parser.HTMLParser):
    """Where each tag of a body starts, as an offset into the text.

    `append_decision` splices a string in at one of these, so the rest of the
    body goes back byte for byte: the editor's classes and ids included.
    """

    def __init__(self, text):
        super().__init__(convert_charrefs=True)
        self.lines = [0] + [m.end() for m in re.finditer("\n", text)]
        self.tags, self.text = [], []
        self.feed(text)
        self.close()

    def _at(self):
        line, column = self.getpos()
        return self.lines[line - 1] + column

    def handle_starttag(self, tag, attrs):
        self.tags.append([self._at(), tag, True, ""])

    def handle_endtag(self, tag):
        self.tags.append([self._at(), tag, False, ""])

    def handle_data(self, data):
        # A heading's words, gathered on the last tag seen before them.
        if self.tags:
            self.tags[-1][3] += data


def _heading_level(tag):
    return int(tag[1]) if re.fullmatch(r"h[1-6]", tag) else None


def append_decision(chart_html, line_html, item_url):
    """A star chart body with `line_html` appended under "Decisions".

    Only that section is touched: charts still carry ticket lists and other
    sections in any order. The line goes at the end of the first list after
    the heading; with no list, a new one starts right after the heading; with
    no section, one goes in before "Nebulae", or at the end. A body
    whose section already has a line led by a link to `item_url` comes back
    as it was, so a re-run after a failure finishes the job without a second
    line.
    """
    body = chart_html or ""
    tags = _Tags(body).tags
    # A heading's text is the words after its open tag and every tag inside
    # it, up to its own close tag. Headings do not nest.
    headings = []
    for number, (_, tag, opening, _) in enumerate(tags):
        level = _heading_level(tag)
        if opening and level:
            close = next(
                (k for k in range(number + 1, len(tags)) if tags[k][1] == tag), len(tags) - 1
            )
            words = "".join(t[3] for t in tags[number:close])
            headings.append((number, close, level, " ".join(words.split()).lower()))
    section = next((h for h in headings if h[3] == DECISIONS), None)
    wrapped = body.rstrip().endswith("</div>") and body.lstrip().startswith("<div")
    end = body.rstrip().rindex("</div>") if wrapped else len(body)
    if section is None:
        later = next((h for h in headings if h[3] == "nebulae"), None)
        at = tags[later[0]][0] if later else end
        return body[:at] + f"<h2>Decisions</h2><ul>{line_html}</ul>" + body[at:]

    opened, closed, level, _ = section
    after_heading = body.index(">", tags[closed][0]) + 1
    stop = next((tags[h[0]][0] for h in headings if h[0] > closed and h[2] <= level), end)
    # Indexed means a line that opens with a link to the item: only tags, no
    # words, before it, so a title bolded in the editor still counts. A link in
    # some other line's gist is a mention, not the line (PLAT-290).
    leading_link = r"<li\b[^>]*>(?:\s*</?(?!a\b)[a-z][^>]*>)*\s*<a\b[^>]*\bhref=[\"']"
    if re.search(leading_link + re.escape(item_url.rstrip("/")) + r"/?[\"']", body[after_heading:stop]):
        return body
    # The section's list is the first one that opens inside it; its own close
    # tag is found by depth, so a list nested in a decision does not end it.
    depth, start = 0, None
    for at, tag, opening, _ in tags[closed + 1:]:
        if at >= stop:
            break
        if tag not in ("ul", "ol"):
            continue
        if opening:
            start = at if start is None else start
            depth += 1
        elif start is not None:
            depth -= 1
            if depth == 0:
                return body[:at] + line_html + body[at:]
    return body[:after_heading] + f"<ul>{line_html}</ul>" + body[after_heading:]


def png_size(content):
    """A PNG's width and height in pixels, read from its header; None for any other file."""
    if content[:8] != b"\x89PNG\r\n\x1a\n" or content[12:16] != b"IHDR":
        return None
    width, height = int.from_bytes(content[16:20], "big"), int.from_bytes(content[20:24], "big")
    return (width, height) if width and height else None


def chart_section(chart_html):
    """Where the drawing goes in a star chart body: (start, end), or None with no Chart heading.

    It starts right after the heading. When an image opens the section, the
    span covers it, so a redrawn chart shows only the new drawing.
    """
    body = chart_html or ""
    tags = _Tags(body).tags
    heading = next(
        (n for n, (_, tag, opening, words) in enumerate(tags)
         if opening and _heading_level(tag) and " ".join(words.split()).lower() == "chart"),
        None,
    )
    close = next((k for k in range(heading + 1, len(tags)) if tags[k][1] == tags[heading][1]), None) \
        if heading is not None else None
    if close is None:
        return None
    start = end = body.index(">", tags[close][0]) + 1
    first = tags[close + 1] if close + 1 < len(tags) else None
    if first and first[2] and first[1] == "image-component":
        after = tags[close + 2] if close + 2 < len(tags) else None
        last = after if after and after[1] == first[1] and not after[2] else first
        end = body.index(">", last[0]) + 1
    return start, end


def show_chart(chart_html, section, asset_id, width, height, block_id):
    """A star chart body with the image `asset_id` in `section`, from `chart_section`.

    Plane shows an attachment only in its panel, where a click downloads it.
    Its editor shows an image inline as an `image-component` whose `src` is a
    file id of the project, and an attachment's id works. The page shrinks a
    wide image to fit, so `width` is the drawing's own.
    """
    body = chart_html or ""
    image = (
        f'<image-component src="{asset_id}" id="{block_id}" width="{width}px" height="auto" '
        f'aspectRatio="{width / height:.4f}" alignment="left" status="uploaded"></image-component>'
    )
    return body[:section[0]] + image + body[section[1]:]


def chart_mermaid(children, relations_by_item, states_by_id, labels_by_id, reference_by_id,
                  course=()):
    """A star chart's drawing as Mermaid, built from its children and blockers.

    A node is `PROJ-N kind: title`, an edge runs from a blocker to what it
    blocks and the frontier is drawn thick. An open
    blocker outside the chart is a node of its own, and a warp's `course`
    (references) is drawn yellow in place of the frontier. A closed ticket is
    left out: the drawing shows the course ahead, and the log is in the
    tracker. Tickets with no edge stack in a column per kind, ten to a
    column, because Mermaid lays them out in one row otherwise.
    """
    def label(text):
        text = " ".join((text or "").split())
        return text.replace('"', "'").replace("[", "(").replace("]", ")")[:60]

    every_id = {str(c["id"]) for c in children}
    children = [c for c in children if is_open(c, states_by_id)]
    node, kind_of, lines = {}, {}, []
    for child in sorted(children, key=lambda c: c.get("sequence_id") or 0):
        item_id = str(child["id"])
        names = [labels_by_id.get(str(l), {}).get("name", "") for l in child.get("labels") or []]
        kind = next((n.split(":", 1)[1] for n in names if n.startswith("starchart:")), "star")
        node[item_id], kind_of[item_id] = f"N{child['sequence_id']}", kind.replace("-", " ")
        lines.append(
            f'{node[item_id]}["{reference_by_id.get(item_id, item_id)} {kind_of[item_id]}: '
            f'{label(child.get("name"))}"]'
        )
    edges, outside = [], []
    for item_id, relation in relations_by_item.items():
        for blocker in relation.get("blocked_by", []):
            blocker_id = str(blocker["issue_id"])
            if blocker_id not in node and blocker_id in reference_by_id and blocker_id not in every_id:
                node[blocker_id] = "X" + reference_by_id[blocker_id].replace("-", "")
                outside.append(f'{node[blocker_id]}["{reference_by_id[blocker_id]} on another chart"]')
            if blocker_id in node and item_id in node:
                edges.append(f"{node[blocker_id]} --> {node[item_id]}")
    linked = {name for edge in edges for name in edge.split(" --> ")}
    out = ["flowchart TD"] + [f"  {line}" for line in lines + outside if line.split("[")[0] in linked]
    columns, column_number = {}, 0
    for item_id in node:
        if node[item_id] not in linked and item_id in kind_of:
            columns.setdefault(kind_of[item_id], []).append(node[item_id])
    for kind, members in columns.items():
        for start in range(0, len(members), 10):
            column, column_number = members[start:start + 10], column_number + 1
            out += [f'  subgraph C{column_number}["{kind}"]', "    direction TB"]
            out += [f"    {line}" for line in lines if line.split("[")[0] in column]
            out += [f"    {a} ~~~ {b}" for a, b in zip(column, column[1:])]
            out.append("  end")
    out += [f"  {edge}" for edge in edges]
    out += ["  classDef frontier stroke-width:3px", "  classDef course fill:#fde68a"]
    outside_ids = set(reference_by_id) - every_id
    ready = [node[str(c["id"])] for c in frontier(children, relations_by_item, states_by_id, outside_ids)]
    by_reference = {reference_by_id.get(i, i): name for i, name in node.items()}
    lit = [by_reference[r] for r in course if r in by_reference]
    ready = [name for name in ready if name not in lit]
    if lit:
        out.append(f"  class {','.join(lit)} course")
    if ready:
        out.append(f"  class {','.join(ready)} frontier")
    return "\n".join(out) + "\n"


def render_chart(mermaid):
    """Mermaid to PNG bytes with mermaid-cli, at the drawing's own width.

    mmdc shrinks every chart to 800 pixels by default, which leaves a big one
    unreadable. mmdc comes from the path, or from nixpkgs when it is missing.
    """
    command = ["mmdc"] if shutil.which("mmdc") else ["nix", "shell", "nixpkgs#mermaid-cli", "-c", "mmdc"]
    with tempfile.TemporaryDirectory() as folder:
        config = os.path.join(folder, "natural.json")
        with open(config, "w") as handle:
            json.dump({"flowchart": {"useMaxWidth": False}}, handle)
        with open(os.path.join(folder, "chart.mmd"), "w") as handle:
            handle.write(mermaid)
        try:
            drawn = subprocess.run(
                command + ["-q", "-c", config, "-i", os.path.join(folder, "chart.mmd"),
                           "-o", os.path.join(folder, "chart.png")],
                capture_output=True, text=True, timeout=300,
            )
        except (OSError, subprocess.TimeoutExpired) as error:
            raise SystemExit(f"plane: cannot run mmdc or nix to draw the chart: {error}") from error
        if drawn.returncode != 0:
            raise SystemExit(f"plane: mmdc failed: {' '.join(drawn.stderr.split()[-40:])}")
        with open(os.path.join(folder, "chart.png"), "rb") as handle:
            return handle.read()


def show_drawing(client, project_id, item, reference, content):
    """Attach a chart's PNG and show it under the body's Chart heading; the attachment.

    The body is read right before it is written, as `resolve` does, because
    drawing can take minutes and an edit made meanwhile would be lost.
    """
    attached = client.attach(project_id, item["id"], "chart.png", content, "image/png")
    body = client.work_item_detail(project_id, item["id"]).get("description_html")
    section = chart_section(body)
    if section is None:
        raise SystemExit(f"plane: {reference} lost its Chart heading; chart.png is attached but not shown")
    shown = show_chart(body, section, attached["id"], *png_size(content), uuid.uuid4())
    client.update_work_item(project_id, item["id"], {"description_html": shown})
    return attached


def thread(comments):
    """Comments oldest first, the order `show` numbers them in.

    The API answers newest first; a thread reads oldest first. The API
    writes every date in one zone, so the strings sort as the times do.
    """
    return sorted(comments, key=lambda c: c.get("created_at") or "")


def pick_comment(reference, comments, number, expect):
    """The comment `show` printed as `#number`, if it is still the one read.

    A number alone can point at another comment once one is posted or deleted
    in between, so the caller passes the token `show` printed beside it too.
    """
    ordered = thread(comments)
    if not 1 <= number <= len(ordered):
        raise SystemExit(f"refused: {reference} has no comment #{number}; it has {len(ordered)}")
    comment = ordered[number - 1]
    current = body_token(comment.get("comment_html"))
    if current != expect:
        raise SystemExit(
            f"refused: {reference} comment #{number} is {current}, not {expect}; "
            f"it changed since it was read, so show it again"
        )
    return comment


def show_text(reference, item, comments, relations, states_by_id, labels_by_id, members_by_id,
              related_by_id, base_url, workspace):
    """What `show` prints: a header of names, the body, then every comment.

    Pure, like `child_lines`: the caller fetches, this only formats.
    `related_by_id` holds `PROJ-N title` for the parent and every blocker in
    either direction. An id with no name prints as the id, so a lookup that
    missed is visible instead of silently dropped.
    """
    def names(ids, lookup):
        return ", ".join(lookup(str(i)) for i in ids or [])

    header = [
        f"{reference} {item.get('name') or ''}".rstrip(),
        "state: " + states_by_id.get(str(item.get("state")), {}).get("name", ""),
        "labels: " + names(item.get("labels"), lambda i: labels_by_id.get(i, {}).get("name", i)),
        "assignees: " + names(item.get("assignees"), lambda i: members_by_id.get(i, i)),
    ]
    if item.get("parent"):
        header.append("parent: " + related_by_id.get(str(item["parent"]), str(item["parent"])))
    for kind, label in (("blocked_by", "blocked by"), ("blocking", "blocking")):
        for other in (relations or {}).get(kind, []):
            other_id = str(other["issue_id"])
            header.append(f"{label}: {related_by_id.get(other_id, other_id)}")
    # What `edit --expect` wants: proof the caller read the body it replaces.
    header.append("body: " + body_token(item.get("description_html")))
    # A header line with nothing after its colon says nothing.
    sections = ["\n".join(line for line in header if not line.endswith(": "))]
    body = html_to_markdown(item.get("description_html"), base_url, workspace)
    if body:
        sections.append(body)
    # The number and token are what `edit-comment` and `delete-comment` want.
    for number, comment in enumerate(thread(comments), 1):
        author = members_by_id.get(str(comment.get("actor")), str(comment.get("actor")))
        when = (comment.get("created_at") or "")[:16].replace("T", " ")
        token = body_token(comment.get("comment_html"))
        sections.append(f"--- #{number} {author}, {when}, body {token}")
        text = html_to_markdown(comment.get("comment_html"), base_url, workspace)
        if text:
            sections.append(text)
    return "\n\n".join(sections) + "\n"


# --- client ----------------------------------------------------------------


def multipart_body(fields, name, content, content_type):
    """A multipart form for a presigned storage upload: the fields in order, the file last.

    Storage checks the policy against the fields before it reads the file, so
    the file part has to come after every field.
    """
    boundary = f"sow-plane-{uuid.uuid4().hex}"
    parts = [
        f'--{boundary}\r\nContent-Disposition: form-data; name="{key}"\r\n\r\n{value}\r\n'.encode()
        for key, value in fields.items()
    ]
    parts.append(
        f'--{boundary}\r\nContent-Disposition: form-data; name="file"; '
        f'filename="{name}"\r\nContent-Type: {content_type}\r\n\r\n'.encode()
        + content + b"\r\n"
    )
    parts.append(f"--{boundary}--\r\n".encode())
    return boundary, b"".join(parts)


class PlaneError(RuntimeError):
    """A failed call, carrying what the API said about it.

    `status` and `payload` exist because one refusal is not an error at all:
    a create whose external reference is taken comes back 409 with the id of
    the item that already holds it, which is how a re-run finds its own work.
    """

    def __init__(self, message, status=None, payload=None):
        super().__init__(message)
        self.status = status
        self.payload = payload if isinstance(payload, dict) else {}

    @classmethod
    def from_http(cls, method, url, error):
        detail = error.read().decode(errors="replace")[:500]
        try:
            payload = json.loads(detail)
        except ValueError:
            payload = None
        return cls(f"{method} {url} -> {error.code}: {detail}", status=error.code, payload=payload)


class Plane:
    """Every call to Plane's public API. Nothing else talks to it."""

    def __init__(self, base_url=None, workspace=None, api_key=None, timeout=30):
        stored = config_file_values()

        def setting(given, name):
            return (
                given
                or os.environ.get(name)
                or stored.get(name)
                or DEFAULTS.get(name, "")
            ).strip()

        self.base_url = setting(base_url, "PLANE_BASE_URL").rstrip("/")
        self.workspace = setting(workspace, "PLANE_WORKSPACE")
        self.api_key = setting(api_key, "PLANE_API_KEY")
        self.timeout = timeout
        if not (self.base_url and self.workspace and self.api_key):
            raise PlaneError(
                "set PLANE_API_KEY in the environment, or put it in "
                f"{CONFIG_FILE}. Mint a key from your tracker profile's API "
                "tokens."
            )
        self._projects = None
        self._legacy_index = {}

    # -- transport

    @staticmethod
    def repeatable(method, body, status):
        """Whether this exact call may be sent again after `status`.

        A 429 always may: the throttle refused it, so nothing happened. A
        gateway error is different -- 502 can mean the write landed and the
        answer was lost. So a repeat needs the call to say what it is: reading
        and patching name their target, and a POST is safe only when its
        payload carries an external reference, which Plane answers with 409 and
        the id it already holds. A relation or a link POST carries none, and
        there is no DELETE on relations to undo a double write.
        """
        if status == 429:
            return True
        if status not in RETRY_STATUSES:
            return False
        if method in ("GET", "PATCH", "PUT"):
            return True
        return bool(body and body.get("external_id"))

    def request(self, method, path, body=None, query=None, workspace=True):
        """One call, waiting out a refusal that says nothing about the work.

        Plane throttles the public API per key. A migration makes tens of
        thousands of calls, so meeting a 429 is normal and stopping on one
        would mean restarting an hour of work. A gateway error is waited out
        the same way when the call is safe to repeat. Everything else is
        raised.

        Almost every endpoint lives under the workspace. `workspace=False` is
        for the few that do not, such as `users/me/`.
        """
        for attempt in range(RATE_LIMIT_RETRIES):
            try:
                return self._request(method, path, body, query, workspace)
            except PlaneError as error:
                last = attempt == RATE_LIMIT_RETRIES - 1
                if last or not self.repeatable(method, body, error.status):
                    raise
                wait = min(RATE_LIMIT_BACKOFF * (2 ** attempt), RATE_LIMIT_CEILING)
                # A silent wait reads as a hang, so say what the client waits for.
                print(f"plane: {method} {path} -> {error.status}, waiting {wait}s "
                      f"(try {attempt + 2} of {RATE_LIMIT_RETRIES})", file=sys.stderr)
                time.sleep(wait)
        raise AssertionError("unreachable")

    def _request(self, method, path, body=None, query=None, workspace=True):
        prefix = f"workspaces/{self.workspace}/" if workspace else ""
        url = f"{self.base_url}/api/v1/{prefix}{path.lstrip('/')}"
        if query:
            url = f"{url}?{urllib.parse.urlencode(query)}"
        data = None if body is None else json.dumps(body).encode()
        request = urllib.request.Request(url, data=data, method=method)
        request.add_header("X-API-Key", self.api_key)
        request.add_header("User-Agent", USER_AGENT)
        if data is not None:
            request.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(request, timeout=self.timeout) as response:
                payload = response.read()
        except urllib.error.HTTPError as error:
            raise PlaneError.from_http(method, url, error) from error
        if not payload:
            return None
        return json.loads(payload)

    def paged(self, path, query=None):
        """Every result across Plane's cursor pagination."""
        query = dict(query or {})
        while True:
            page = self.request("GET", path, query=query)
            if isinstance(page, list):
                yield from page
                return
            yield from page.get("results", [])
            cursor = page.get("next_cursor")
            if not page.get("next_page_results") or not cursor:
                return
            query["cursor"] = cursor

    # -- projects, states, labels

    def projects(self):
        """Every project, fetched once: one command asks several times."""
        if self._projects is None:
            self._projects = list(self.paged("projects/"))
        return self._projects

    def project(self, identifier):
        """A project by its short identifier, e.g. SOW.

        A miss fetches the list again before it fails. The bridge keeps one
        client for as long as it runs, and a project created after it started
        has to be found without a restart.
        """
        for _ in range(2):
            for project in self.projects():
                if project["identifier"] == identifier:
                    return project
            self._projects = None
        raise PlaneError(f"no project with identifier {identifier!r}")

    def me(self):
        """The user who owns the API key."""
        return self.request("GET", "users/me/", workspace=False)

    def members(self):
        return list(self.paged("members/"))

    def members_by_login(self):
        """Workspace members, keyed by every handle an old tracker login might match.

        The old tracker and Plane share no identifier, so every handle a member
        carries is indexed, and an assignee that matches none of them is
        reported rather than guessed at.
        """
        index = {}
        for entry in self.members():
            user = entry.get("member") if isinstance(entry.get("member"), dict) else entry
            user_id = user.get("id") or entry.get("member") or entry.get("id")
            # No local part of an email address: two people whose addresses
            # start the same way would map to whichever was read first, and a
            # wrong assignee on a migrated item is silent. An exact handle or
            # nothing.
            handles = [
                user.get("display_name"),
                user.get("username"),
                user.get("email"),
            ]
            for handle in handles:
                if handle:
                    index.setdefault(str(handle).lower(), {"id": user_id})
        return index

    def index_by_legacy(self, project_id):
        """Every migrated work item in a project, by the Gitea issue it came from."""
        if project_id not in self._legacy_index:
            self._legacy_index[project_id] = {
                item["external_id"]: item
                for item in self.work_items(project_id)
                if item.get("external_id") and item.get("external_source") == EXTERNAL_SOURCE
            }
        return self._legacy_index[project_id]

    def reference_index(self):
        """Every migrated work item in the workspace, as `owner/repo#n` -> `PROJ-12`.

        What a body's `#319` has to become. It spans projects because a
        reference does: four repositories share `GAME`, and a platform ticket
        cites a game one all the time.
        """
        index = {}
        for project in self.projects():
            identifier = project.get("identifier")
            for legacy, item in self.index_by_legacy(project["id"]).items():
                if identifier and item.get("sequence_id"):
                    index[legacy] = f"{identifier}-{item['sequence_id']}"
        return index

    def find_by_legacy(self, legacy):
        """A migrated work item anywhere in the workspace, or None.

        Blocking crosses projects -- the star charts already depend on each other
        across repositories -- so a blocker is looked for everywhere and not
        only in the project being imported.
        """
        for project in self.projects():
            found = self.index_by_legacy(project["id"]).get(legacy)
            if found:
                return found
        return None

    def work_item_by_legacy(self, external_id):
        """The project and item imported from `owner/repo#n`, looked up by filter.

        The repository does not say which project the item went to -- twelve
        repositories share three -- so each project is asked. A hit comes back
        as the item itself and a miss as 404, which makes this a handful of
        requests where `find_by_legacy` reads every item in the workspace. The
        answer is checked against the id asked for, because a filter Plane
        ignored would hand back a page of everything instead.
        """
        query = {"external_id": external_id, "external_source": EXTERNAL_SOURCE}
        for project in self.projects():
            try:
                item = self.request("GET", f"projects/{project['id']}/work-items/", query=query)
            except PlaneError as error:
                if error.status == 404:
                    continue
                raise
            if isinstance(item, dict) and item.get("external_id") == external_id:
                return project, item
        raise PlaneError(f"no work item was imported from {external_id}")

    def states(self, project_id):
        return {str(s["id"]): s for s in self.paged(f"projects/{project_id}/states/")}

    def state_in_group(self, project_id, group):
        for state in self.states(project_id).values():
            if state.get("group") == group:
                return state
        raise PlaneError(f"project {project_id} has no state in group {group!r}")

    def state_named(self, project_id, name):
        """The state called `name` in this project, matched without case.

        States belong to a project, so the same name is a different id in each.
        An unknown name lists the ones that exist, as `label_ids` does.
        """
        states = list(self.states(project_id).values())
        for state in states:
            if str(state.get("name", "")).lower() == str(name).strip().lower():
                return state
        raise PlaneError(
            f"unknown state {name!r}; this project has: "
            f"{', '.join(sorted(s.get('name', '?') for s in states))}"
        )

    def labels(self, project_id):
        return {label["name"]: label for label in self.paged(f"projects/{project_id}/labels/")}

    def label_ids(self, project_id, names):
        """Label ids for `names`, all of which must already exist.

        Creating a label is a deliberate act, not a side effect of a typo: a
        comma list once became one junk label and the command exited 0.
        """
        existing = self.labels(project_id)
        unknown = [name for name in names if name not in existing]
        if unknown:
            raise PlaneError(
                f"unknown label(s) {', '.join(unknown)}; "
                f"this project has: {', '.join(sorted(existing))}"
            )
        return [existing[name]["id"] for name in names]

    def ensure_labels(self, project_id, names):
        """Label ids for `names`, creating the ones that do not exist yet."""
        existing = self.labels(project_id)
        ids = []
        for name in names:
            label = existing.get(name)
            if label is None:
                label = self.request("POST", f"projects/{project_id}/labels/", {"name": name})
                existing[name] = label
            ids.append(label["id"])
        return ids

    # -- work items

    def work_item(self, reference):
        """One work item by its `PROJ-123` reference."""
        identifier, sequence = parse_reference(reference)
        return self.request("GET", f"work-items/{identifier}-{sequence}/")

    def work_items(self, project_id, query=None):
        return list(self.paged(f"projects/{project_id}/work-items/", query))

    def create_work_item(self, project_id, fields):
        return self.request("POST", f"projects/{project_id}/work-items/", fields)

    def upsert_work_item(self, project_id, fields):
        """Create, or update the item already carrying this external reference.

        There is no upsert verb: the work-item collection takes POST only, and
        answers a repeated external reference with 409 and the id of the item
        that already holds it. So the create IS the lookup, and the second call
        patches what the first one found. That round trip is what makes the
        importer re-runnable -- a failed batch is retried, never cleaned up by
        hand -- and it costs one extra request per already-imported issue.
        """
        if not fields.get("external_id") or not fields.get("external_source"):
            raise PlaneError("upsert needs external_id and external_source")
        try:
            return self.create_work_item(project_id, fields)
        except PlaneError as error:
            existing = error.payload.get("id") if error.status == 409 else None
            if not existing:
                raise
            return self.update_work_item(project_id, existing, fields)

    def update_work_item(self, project_id, item_id, fields):
        return self.request("PATCH", f"projects/{project_id}/work-items/{item_id}/", fields)

    def close_work_item(self, project_id, item_id):
        state = self.state_in_group(project_id, "completed")
        return self.update_work_item(project_id, item_id, {"state": state["id"]})

    def set_state(self, project_id, item_id, name):
        state = self.state_named(project_id, name)
        return self.update_work_item(project_id, item_id, {"state": state["id"]})

    def set_priority(self, project_id, item_id, priority):
        return self.update_work_item(project_id, item_id, {"priority": priority})

    def unassign(self, project_id, item_id, current, user_id):
        """Drop one assignee and keep the rest. Plane takes the whole list."""
        kept = [u for u in current if str(u) != str(user_id)]
        return self.update_work_item(project_id, item_id, {"assignees": kept})

    def change_labels(self, project_id, item_id, current, add, remove):
        """Add and remove labels by name; every name must already exist."""
        add_ids = self.label_ids(project_id, add)
        remove_ids = {str(i) for i in self.label_ids(project_id, remove)}
        labels = [i for i in current if str(i) not in remove_ids]
        labels += [i for i in add_ids if str(i) not in {str(x) for x in labels}]
        return self.update_work_item(project_id, item_id, {"labels": labels})

    def set_parent(self, project_id, item_id, parent_id):
        return self.update_work_item(project_id, item_id, {"parent": parent_id})

    def assign(self, project_id, item_id, user_ids):
        return self.update_work_item(project_id, item_id, {"assignees": list(user_ids)})

    # -- comments, links, relations

    def work_item_detail(self, project_id, item_id):
        """One work item by its id, with the fields the list view may omit."""
        return self.request("GET", f"projects/{project_id}/work-items/{item_id}/")

    def related_detail(self, project_id, item_id):
        """A parent or blocker by id, or None once it is archived or deleted.

        A relation outlives the item at its other end, and the public API can
        neither list an archived item nor delete the relation. An item that is
        gone blocks nothing.
        """
        try:
            return self.work_item_detail(project_id, item_id)
        except PlaneError as error:
            if error.status == 404:
                return None
            raise

    def comments(self, project_id, item_id):
        return list(self.paged(f"projects/{project_id}/work-items/{item_id}/comments/"))

    def update_comment(self, project_id, item_id, comment_id, html):
        """Rewrite a comment in place.

        A comment is created, not upserted: posting one whose external_id is
        already taken is an error, not an update. So a caller that may be
        writing a second time has to read the thread and patch what is there --
        which is what makes re-running the importer safe.
        """
        return self.request(
            "PATCH",
            f"projects/{project_id}/work-items/{item_id}/comments/{comment_id}/",
            {"comment_html": html},
        )

    def delete_comment(self, project_id, item_id, comment_id):
        return self.request(
            "DELETE", f"projects/{project_id}/work-items/{item_id}/comments/{comment_id}/"
        )

    def comment(self, project_id, item_id, html, external_id=None):
        """Add a comment. With an external id, a repeat is a no-op.

        Plane answers a taken external id with 409 and the id of the comment
        that holds it. That comment is the one this call would have made.
        """
        body = {"comment_html": html}
        if external_id:
            body["external_id"] = external_id
            body["external_source"] = EXTERNAL_SOURCE
        try:
            return self.request("POST", f"projects/{project_id}/work-items/{item_id}/comments/", body)
        except PlaneError as error:
            if external_id and error.status == 409 and error.payload.get("id"):
                return {"id": error.payload["id"]}
            raise

    def links(self, project_id, item_id):
        return list(self.paged(f"projects/{project_id}/work-items/{item_id}/links/"))

    def link(self, project_id, item_id, url, title=None):
        """Attach a URL once. A second call with the same URL is a no-op."""
        for existing in self.links(project_id, item_id):
            if existing.get("url") == url:
                return existing
        return self.request(
            "POST",
            f"projects/{project_id}/work-items/{item_id}/links/",
            {"url": url, "title": title or url},
        )

    def attach(self, project_id, item_id, name, content, content_type):
        """Upload a file onto a work item, replacing an earlier one of the same name.

        Plane takes a file in three calls: it hands out a presigned upload, the
        file goes straight to storage with no API key, and a PATCH marks it
        uploaded. A redrawn chart keeps its name, so once the new copy is in,
        every older one of that name is deleted. A failed upload leaves the
        old copy in place, and a re-run finishes the job.
        """
        path = f"projects/{project_id}/work-items/{item_id}/attachments/"
        ticket = self.request(
            "POST", path, {"name": name, "type": content_type, "size": len(content)}
        )
        upload = ticket["upload_data"]
        self._upload(upload["url"], upload["fields"], name, content, content_type)
        self.request("PATCH", f"{path}{ticket['asset_id']}/", {"is_uploaded": True})
        for old in self.request("GET", path) or []:
            if (old.get("attributes") or {}).get("name") == name and old["id"] != ticket["asset_id"]:
                self.request("DELETE", f"{path}{old['id']}/")
        return ticket["attachment"]

    def _upload(self, url, fields, name, content, content_type):
        """The file goes to storage as the presigned upload says, with no API key."""
        boundary, body = multipart_body(fields, name, content, content_type)
        request = urllib.request.Request(url, data=body, method="POST")
        request.add_header("Content-Type", f"multipart/form-data; boundary={boundary}")
        request.add_header("User-Agent", USER_AGENT)
        try:
            with urllib.request.urlopen(request, timeout=self.timeout):
                pass
        except urllib.error.HTTPError as error:
            raise PlaneError.from_http("POST", url, error) from error

    def relations(self, project_id, item_id):
        return self.request("GET", f"projects/{project_id}/work-items/{item_id}/relations/")

    def add_relation(self, project_id, item_id, relation_type, related_ids):
        return self.request(
            "POST",
            f"projects/{project_id}/work-items/{item_id}/relations/",
            {"relation_type": relation_type, "issues": list(related_ids)},
        )

    def block(self, project_id, item_id, blocker_ids):
        return self.add_relation(project_id, item_id, "blocked_by", blocker_ids)

    # -- star charts

    def children(self, project_id, parent_id):
        """A star chart's children, their relations by id, and the project's states.

        Every item in the project is read and filtered here, because the list
        endpoint ignores `parent=` and hands back the whole project. Move to the
        server when Plane's public API grows a filter that narrows.
        """
        states = self.states(project_id)
        children = [
            item
            for item in self.work_items(project_id)
            if str(item.get("parent")) == str(parent_id)
        ]
        relations = {
            str(child["id"]): self.relations(project_id, child["id"]) for child in children
        }
        return children, relations, states

    def child_references(self, project_id, children, relations):
        """`PROJ-N` for every child, and for every open blocker outside them.

        A child's reference is already in hand. A blocker outside the list --
        often in another project, since star charts depend on each other across
        repositories -- costs one fetch, and its project's states one more per
        project. A closed one is left out, which is how `child_lines` knows not
        to name it.
        """
        identifiers = {str(p["id"]): p["identifier"] for p in self.projects()}
        references = {
            str(c["id"]): f"{identifiers[str(project_id)]}-{c['sequence_id']}" for c in children
        }
        states, seen = {}, set(references)
        for relation in relations.values():
            for blocker in relation.get("blocked_by", []):
                blocker_id = str(blocker["issue_id"])
                if blocker_id in seen:
                    continue
                seen.add(blocker_id)
                home = str(blocker.get("project_id") or project_id)
                if home not in states:
                    states[home] = self.states(home)
                item = self.related_detail(home, blocker_id)
                if item is not None and is_open(item, states[home]):
                    references[blocker_id] = f"{identifiers[home]}-{item['sequence_id']}"
        return references

    def child_lines(self, project_id, children, relations, states, references):
        """The lines `children` and `frontier` print, with names looked up."""
        labels_by_id = {str(label["id"]): label for label in self.labels(project_id).values()}
        members_by_id = {
            str(m["id"]): m.get("display_name") or str(m["id"]) for m in self.members()
        }
        return child_lines(children, relations, states, labels_by_id, members_by_id, references)

    def show_text(self, project_id, item, reference, comments, relations):
        """The text `show` prints, with every UUID looked up as a name.

        The parent and each blocker cost one fetch apiece; a relation carries
        its own project, since blocking crosses projects.
        """
        labels_by_id = {str(label["id"]): label for label in self.labels(project_id).values()}
        members_by_id = {
            str(m["id"]): m.get("display_name") or str(m["id"]) for m in self.members()
        }
        identifiers = {str(p["id"]): p["identifier"] for p in self.projects()}
        wanted = [(str(project_id), str(item["parent"]))] if item.get("parent") else []
        for kind in ("blocked_by", "blocking"):
            for other in (relations or {}).get(kind, []):
                wanted.append((str(other.get("project_id") or project_id), str(other["issue_id"])))
        # Each line carries the other item's state: a blocker that closed long
        # ago otherwise reads exactly like one still in the way.
        states = {str(project_id): self.states(project_id)}
        related = {}
        for home, other_id in wanted:
            if other_id not in related:
                other = self.related_detail(home, other_id)
                if other is None:
                    related[other_id] = f"{other_id} (archived or deleted)"
                    continue
                if home not in states:
                    states[home] = self.states(home)
                state = states[home].get(str(other.get("state")), {}).get("name", "")
                related[other_id] = (
                    f"{identifiers.get(home, home)}-{other['sequence_id']} "
                    f"{other.get('name') or ''} ({state})"
                )
        return show_text(
            reference, item, comments, relations, states[str(project_id)], labels_by_id,
            members_by_id, related, self.base_url, self.workspace,
        )


# --- command surface -------------------------------------------------------


def _resolve(client, reference):
    """A reference from the command line: its project id, the item, and `PROJ-N`.

    Every command routes through here, so an old Gitea reference works
    anywhere a `PROJ-N` does. What comes back is always the `PROJ-N`, so a
    line printed afterwards names the item as it is called now.
    """
    legacy = legacy_external_id(reference)
    if legacy:
        project, item = client.work_item_by_legacy(legacy)
    else:
        identifier, _ = parse_reference(reference)
        project = client.project(identifier)
        item = client.work_item(reference)
    return project["id"], item, f"{project['identifier']}-{item['sequence_id']}"


def _body_html(client, args):
    """The body a write was given, as HTML: a file, `--body`, or `comment`'s
    positional text, all read as Markdown. Never stdin: an agent's shell
    sends no EOF, so a read from it waits forever."""
    if getattr(args, "body_file", None):
        try:
            with open(args.body_file, encoding="utf-8") as handle:
                text = handle.read()
        except OSError as error:
            raise SystemExit(f"cannot read --body-file: {error.strerror}: {args.body_file}")
    else:
        text = getattr(args, "body", None) or getattr(args, "text", None) or ""
    identifiers = {project["identifier"] for project in client.projects()}
    return markdown_to_html(text, client.base_url, client.workspace, identifiers)


def _print(value):
    print(json.dumps(value, indent=2, sort_keys=True, default=str))


def _report(args, raw, line):
    """A write's answer: its one line, or the raw object under `--json`."""
    if args.json:
        _print(raw)
    else:
        print(line)


def main(argv=None):
    parser = argparse.ArgumentParser(description="Tracker operations against Plane (ADR-0054)")
    sub = parser.add_subparsers(dest="command", required=True)

    # `--json` hands a script the raw object instead of the printed lines.
    raw = argparse.ArgumentParser(add_help=False)
    raw.add_argument("--json", action="store_true", help="print the raw object instead")

    p = sub.add_parser("file", help="create a work item", parents=[raw])
    p.add_argument("project", help="project identifier, e.g. SOW")
    p.add_argument("title")
    body = p.add_mutually_exclusive_group()
    body.add_argument("--body", help="the body, as Markdown")
    body.add_argument("--body-file", help="a file holding the body, as Markdown")
    p.add_argument(
        "--label", action="append", default=[], dest="labels",
        help="an existing label; repeat the flag or separate names with commas",
    )
    p.add_argument("--priority", default=None, help="override the label-derived priority")
    p.add_argument("--assignee", action="append", default=[], dest="assignees")
    p.add_argument("--parent", default=None, help="parent work item reference")

    p = sub.add_parser(
        "show", help="a whole thread as text: header, body, every comment", parents=[raw]
    )
    p.add_argument("reference", help="PROJ-N, or an old Gitea reference such as repo#N")

    p = sub.add_parser("find", help="work items whose title contains the text", parents=[raw])
    p.add_argument("project", help="project identifier, e.g. PLAT")
    p.add_argument("text")

    sub.add_parser("whoami", help="the user who owns the API key, and their id")

    p = sub.add_parser("comment", help="add a comment, written in Markdown", parents=[raw])
    p.add_argument("reference")
    body = p.add_mutually_exclusive_group(required=True)
    body.add_argument("text", nargs="?")
    body.add_argument("--body", help="the comment, as Markdown")
    body.add_argument("--body-file", help="a file holding the comment, as Markdown")

    p = sub.add_parser(
        "edit", help="replace a body whole, if it is still the one you read", parents=[raw]
    )
    p.add_argument("reference")
    body = p.add_mutually_exclusive_group(required=True)
    body.add_argument("--body", help="the new body, as Markdown")
    body.add_argument("--body-file", help="a file holding the new body, as Markdown")
    p.add_argument("--expect", required=True, help="the `body:` token `show` printed")

    p = sub.add_parser(
        "edit-comment", help="replace a comment whole, if it is still the one you read",
        parents=[raw],
    )
    p.add_argument("reference")
    p.add_argument("number", type=int, help="the comment's `#n` in `show`")
    body = p.add_mutually_exclusive_group(required=True)
    body.add_argument("--body", help="the new comment, as Markdown")
    body.add_argument("--body-file", help="a file holding the new comment, as Markdown")
    p.add_argument("--expect", required=True, help="the `body` token `show` printed beside it")

    p = sub.add_parser(
        "delete-comment", help="delete a comment, if it is still the one you read",
        parents=[raw],
    )
    p.add_argument("reference")
    p.add_argument("number", type=int, help="the comment's `#n` in `show`")
    p.add_argument("--expect", required=True, help="the `body` token `show` printed beside it")

    p = sub.add_parser("rename", help="replace a work item's title", parents=[raw])
    p.add_argument("reference")
    p.add_argument("title")

    p = sub.add_parser("close", help="move a work item to a completed state", parents=[raw])
    p.add_argument("reference")

    p = sub.add_parser(
        "resolve", help="comment the answer, index it on the parent star chart, and close",
        parents=[raw],
    )
    p.add_argument("reference")
    body = p.add_mutually_exclusive_group(required=True)
    body.add_argument("--body", help="the resolution, as Markdown")
    body.add_argument("--body-file", help="a file holding the resolution, as Markdown")
    p.add_argument("--gist", required=True, help="one line for the star chart's Decisions")

    p = sub.add_parser(
        "claim", help="assign a work item to a user, by default yourself", parents=[raw]
    )
    p.add_argument("reference")
    p.add_argument("user_id", nargs="?", help="a user id; omitted, the key's owner")

    p = sub.add_parser("state", help="move a work item to a named state", parents=[raw])
    p.add_argument("reference")
    p.add_argument("state", help="a state name in the item's project, e.g. Todo")

    p = sub.add_parser("priority", help="set a work item's priority", parents=[raw])
    p.add_argument("reference")
    p.add_argument("priority", choices=PRIORITIES)

    p = sub.add_parser(
        "unclaim", help="drop an assignee, by default yourself", parents=[raw]
    )
    p.add_argument("reference")
    p.add_argument("user_id", nargs="?", help="a user id; omitted, the key's owner")

    p = sub.add_parser("label", help="add and remove labels by name", parents=[raw])
    p.add_argument("reference")
    p.add_argument("--add", action="append", default=[], dest="add")
    p.add_argument("--remove", action="append", default=[], dest="remove")

    p = sub.add_parser(
        "block", help="record that one item is blocked by others", parents=[raw]
    )
    p.add_argument("reference")
    p.add_argument("blocker", nargs="+")

    p = sub.add_parser("parent", help="make a work item a child of another", parents=[raw])
    p.add_argument("reference")
    p.add_argument("parent")

    p = sub.add_parser(
        "attach", help="upload a file onto a work item, replacing one of the same name",
        parents=[raw],
    )
    p.add_argument("reference")
    p.add_argument("file")
    p.add_argument(
        "--chart", action="store_true",
        help="a star chart's drawing (a PNG): also show it under the body's Chart heading",
    )

    p = sub.add_parser(
        "draw", help="draw a star chart from its tickets and show the drawing under its Chart heading",
        parents=[raw],
    )
    p.add_argument("chart_reference")
    p.add_argument("--mermaid", action="store_true", help="print the Mermaid and change nothing")
    p.add_argument("--course", default="", help="a warp's course and target, PROJ-N,PROJ-N: drawn yellow")

    p = sub.add_parser(
        "children", help="every child of a star chart, one line each, closed ones too", parents=[raw]
    )
    p.add_argument("chart_reference")

    p = sub.add_parser(
        "frontier", help="open, unassigned children of a star chart with no open blocker", parents=[raw]
    )
    p.add_argument("chart_reference")

    args = parser.parse_args(argv)
    client = Plane()

    if args.command == "file":
        args.labels = split_labels(args.labels)
        project = client.project(args.project.upper())
        fields = {
            "name": args.title,
            "description_html": _body_html(client, args),
            "priority": args.priority or priority_for_labels(args.labels),
        }
        if args.labels:
            fields["labels"] = client.label_ids(project["id"], labels_to_carry(args.labels))
        if args.assignees:
            fields["assignees"] = args.assignees
        if args.parent:
            _, parent, _ = _resolve(client, args.parent)
            fields["parent"] = parent["id"]
        created = client.create_work_item(project["id"], fields)
        reference = f"{project['identifier']}-{created.get('sequence_id')}"
        _report(args, created, summary("filed", reference, created))
        return 0

    if args.command == "show":
        project_id, item, reference = _resolve(client, args.reference)
        comments = client.comments(project_id, item["id"])
        relations = client.relations(project_id, item["id"])
        if args.json:
            _print({**item, "comments": comments, "relations": relations})
        else:
            print(client.show_text(project_id, item, reference, comments, relations), end="")
        return 0

    if args.command == "find":
        project = client.project(args.project.upper())
        # Every item is read and matched here, because the list
        # endpoint ignores `search=` and every other text filter tried. Move to
        # the server when Plane's public API grows one that filters.
        items = client.work_items(project["id"])
        if args.json:
            _print(find_items(items, args.text))
        else:
            states = client.states(project["id"])
            for line in find_lines(project["identifier"], items, args.text, states):
                print(line)
        return 0

    if args.command == "whoami":
        print(user_line(client.me()))
        return 0

    if args.command == "comment":
        project_id, item, reference = _resolve(client, args.reference)
        posted = client.comment(project_id, item["id"], _body_html(client, args))
        _report(args, posted, summary("commented on", reference, item))
        return 0

    if args.command == "edit":
        project_id, item, reference = _resolve(client, args.reference)
        new_body = _body_html(client, args)
        # Read again right before the write: the token compares against what
        # is stored now, not what `_resolve` saw a few requests ago. A body
        # replaced by someone who never read it is the lost edit this refuses.
        stored = client.work_item_detail(project_id, item["id"])
        current = body_token(stored.get("description_html"))
        if current != args.expect:
            raise SystemExit(
                f"refused: {reference} body is {current}, not {args.expect}; "
                f"it changed since it was read, so show it again"
            )
        edited = client.update_work_item(project_id, item["id"], {"description_html": new_body})
        _report(args, edited, summary("edited", reference, stored))
        return 0

    if args.command in ("edit-comment", "delete-comment"):
        project_id, item, reference = _resolve(client, args.reference)
        # Read right before the write, as `edit` does.
        comment = pick_comment(
            reference, client.comments(project_id, item["id"]), args.number, args.expect
        )
        if args.command == "edit-comment":
            done = client.update_comment(project_id, item["id"], comment["id"], _body_html(client, args))
            verb = f"edited comment #{args.number} on"
        else:
            done = client.delete_comment(project_id, item["id"], comment["id"])
            verb = f"deleted comment #{args.number} on"
        _report(args, done, summary(verb, reference, item))
        return 0

    if args.command == "rename":
        project_id, item, reference = _resolve(client, args.reference)
        renamed = client.update_work_item(project_id, item["id"], {"name": args.title})
        was = f"(was {item.get('name')})" if item.get("name") != args.title else ""
        _report(args, renamed, summary("renamed", reference, renamed, was))
        return 0

    if args.command == "close":
        project_id, item, reference = _resolve(client, args.reference)
        closed = client.close_work_item(project_id, item["id"])
        _report(args, closed, summary("closed", reference, item))
        return 0

    if args.command == "resolve":
        project_id, item, reference = _resolve(client, args.reference)
        identifier, _ = parse_reference(reference)
        # A re-run after a failure finishes the job; it does not post the
        # answer twice. Compared normalised, since the editor rewrites it.
        answer = _body_html(client, args)
        posted = next(
            (c for c in client.comments(project_id, item["id"])
             if normalize_html(c.get("comment_html")) == normalize_html(answer)),
            None,
        )
        if posted:
            lines = [summary("already commented on", reference, item)]
        else:
            posted = client.comment(project_id, item["id"], answer)
            lines = [summary("commented on", reference, item)]
        # The chart is read right before it is written, as `edit` does: the line
        # goes into the body as it is now, not as it was a few requests ago.
        indexed, parent = None, item.get("parent")
        if parent:
            parent = client.work_item_detail(project_id, parent)
            # A chart and its tickets share a project, so the child's is the chart's.
            label = client.labels(project_id).get("starchart:chart")
            if not label or str(label["id"]) not in {str(i) for i in parent.get("labels") or []}:
                parent = None
        if parent:
            chart_reference = f"{identifier}-{parent['sequence_id']}"
            item_url = f"{client.base_url}/{client.workspace}/browse/{reference}/"
            identifiers = {project["identifier"] for project in client.projects()}
            line = decision_line(item.get("name") or reference, item_url, args.gist,
                                 client.base_url, client.workspace, identifiers)
            stored = parent.get("description_html") or ""
            updated = append_decision(stored, line, item_url)
            if updated == stored:
                lines.append(f"already indexed {reference} on {chart_reference}")
            else:
                indexed = client.update_work_item(
                    project_id, parent["id"], {"description_html": updated}
                )
                lines.append(f"indexed {reference} on {chart_reference}")
        else:
            lines.append(f"not indexed: {reference} has no parent star chart")
        closed = client.close_work_item(project_id, item["id"])
        lines.append(summary("closed", reference, item))
        _report(args, [posted, indexed, closed], "\n".join(lines))
        return 0

    if args.command == "claim":
        project_id, item, reference = _resolve(client, args.reference)
        # No user means the caller: an agent holds a key, not a UUID.
        if args.user_id:
            user_id, who = args.user_id, args.user_id
        else:
            me = client.me()
            user_id, who = me["id"], me.get("display_name") or me["id"]
        claimed = client.assign(project_id, item["id"], [user_id])
        line = summary("claimed", reference, item, f"for {who}")
        # Claiming for yourself is taking the work, so the state says so and
        # a second session sees it. Assigning someone else changes no state.
        # The started group holds In Progress whatever a project calls it.
        if not args.user_id:
            started = client.state_in_group(project_id, "started")
            claimed = client.update_work_item(project_id, item["id"], {"state": started["id"]})
            line += f", {started.get('name', 'started')}"
        _report(args, claimed, line)
        return 0

    if args.command == "state":
        project_id, item, reference = _resolve(client, args.reference)
        moved = client.set_state(project_id, item["id"], args.state)
        _report(args, moved, summary("moved", reference, item, f"to {args.state}"))
        return 0

    if args.command == "priority":
        project_id, item, reference = _resolve(client, args.reference)
        done = client.set_priority(project_id, item["id"], args.priority)
        _report(args, done, summary("set priority of", reference, item, f"to {args.priority}"))
        return 0

    if args.command == "unclaim":
        project_id, item, reference = _resolve(client, args.reference)
        if args.user_id:
            user_id, who = args.user_id, args.user_id
        else:
            me = client.me()
            user_id, who = me["id"], me.get("display_name") or me["id"]
        done = client.unassign(project_id, item["id"], item.get("assignees") or [], user_id)
        _report(args, done, summary("unclaimed", reference, item, f"for {who}"))
        return 0

    if args.command == "label":
        if not (args.add or args.remove):
            raise SystemExit("label needs --add or --remove")
        project_id, item, reference = _resolve(client, args.reference)
        done = client.change_labels(
            project_id, item["id"], item.get("labels") or [], args.add, args.remove
        )
        changes = [f"+{n}" for n in args.add] + [f"-{n}" for n in args.remove]
        _report(args, done, summary("relabelled", reference, item, " ".join(changes)))
        return 0

    if args.command == "block":
        project_id, item, reference = _resolve(client, args.reference)
        blockers = [_resolve(client, blocker) for blocker in args.blocker]
        blocked = client.block(project_id, item["id"], [b[1]["id"] for b in blockers])
        by = "by " + ", ".join(b[2] for b in blockers)
        _report(args, blocked, summary("blocked", reference, item, by))
        return 0

    if args.command == "parent":
        project_id, item, reference = _resolve(client, args.reference)
        _, parent, parent_reference = _resolve(client, args.parent)
        moved = client.set_parent(project_id, item["id"], parent["id"])
        under = f"under {parent_reference}"
        _report(args, moved, summary("parented", reference, item, under))
        return 0

    if args.command == "attach":
        project_id, item, reference = _resolve(client, args.reference)
        name = os.path.basename(args.file)
        content_type = mimetypes.guess_type(name)[0] or "application/octet-stream"
        try:
            with open(args.file, "rb") as handle:
                content = handle.read()
        except OSError as error:
            raise SystemExit(f"plane: {error}") from error
        size = png_size(content)
        if args.chart and not size:
            raise SystemExit(f"plane: --chart takes a PNG, and {args.file} is not one")
        if args.chart and chart_section(item.get("description_html")) is None:
            raise SystemExit(f"plane: {reference} has no Chart heading to show the drawing under")
        if args.chart:
            attached = show_drawing(client, project_id, item, reference, content)
        else:
            attached = client.attach(project_id, item["id"], name, content, content_type)
        _report(args, attached, summary("attached", reference, item, name))
        return 0

    if args.command == "draw":
        project_id, item, reference = _resolve(client, args.chart_reference)
        children, relations, states = client.children(project_id, item["id"])
        if not any(is_open(child, states) for child in children):
            raise SystemExit(f"plane: {reference} has no open tickets to draw")
        references = client.child_references(project_id, children, relations)
        labels_by_id = {str(label["id"]): label for label in client.labels(project_id).values()}
        course = [r.strip().upper() for r in args.course.split(",") if r.strip()]
        mermaid = chart_mermaid(children, relations, states, labels_by_id, references, course)
        if args.mermaid:
            print(mermaid, end="")
            return 0
        if chart_section(item.get("description_html")) is None:
            raise SystemExit(f"plane: {reference} has no Chart heading to show the drawing under")
        attached = show_drawing(client, project_id, item, reference, render_chart(mermaid))
        _report(args, attached, summary("drew", reference, item))
        return 0

    if args.command in ("children", "frontier"):
        project_id, item, _ = _resolve(client, args.chart_reference)
        children, relations, states = client.children(project_id, item["id"])
        references = client.child_references(project_id, children, relations)
        if args.command == "frontier":
            outside = set(references) - {str(c["id"]) for c in children}
            children = frontier(children, relations, states, outside)
            # A ready item has no open blocker, so there is no tail to print.
            relations = {}
        if args.json:
            _print(children)
        else:
            for line in client.child_lines(project_id, children, relations, states, references):
                print(line)
        return 0

    raise SystemExit(f"unknown command {args.command}")


if __name__ == "__main__":
    # A refusal from the API is an answer for the reader, not a crash to debug.
    try:
        sys.exit(main())
    except PlaneError as error:
        sys.exit(f"plane: {error}")
