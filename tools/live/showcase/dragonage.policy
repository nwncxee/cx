card.opt0=[{"width":340,"tab":"Persuade","blocks":[{"type":"text","size":1.2,"text":"Honest, and a little brave","color":"#d9b45a"},{"type":"status","icon":"isk_persuade","text":"Persuasion <c=#ffffff>14</c> against her <c=#ffffff>12</c>","px":22},{"type":"text","text":"<c=#7fcf7f>Likely to succeed.</c> She respects a plain answer, and will tell you what the road holds."},{"type":"footer","left":"Approval <c=#7fcf7f>+3</c>","right":"Opens: the old road"}]}]
card.opt1=[{"width":340,"tab":"Intimidate","blocks":[{"type":"text","size":1.2,"text":"A hard answer","color":"#d9b45a"},{"type":"status","icon":"isk_taunt","text":"Intimidation <c=#ffffff>9</c> against her <c=#ffffff>13</c>","px":22},{"type":"text","text":"<c=#e08a6a>Unlikely.</c> She has buried harder men than you."},{"type":"footer","left":"Approval <c=#e08a6a>-5</c>","right":"Ends the talk"}]}]
