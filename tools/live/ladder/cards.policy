card.img=[{"width":300,"tab":"Equipped","tabcolor":"#000000b0","bg":{"from":"#1d2530f4","to":"#10151cf4","dir":"v"},"border":"#5a6f8c","images":[{"src":"ir_attack","w":96,"h":96,"at":"tr","dx":18,"dy":-26}],"blocks":[{"type":"text","size":1.3,"text":"Jorgoral's Greatsword","color":"#3fa9f5"},{"type":"text","size":0.85,"dim":true,"text":"Rare"},{"type":"status","icon":"ir_attack","text":"Equipped by <c=#ffffff>Florian</c>","size":0.85,"dim":true,"px":16},{"type":"text","size":1.6,"text":"2~12 <s=0.85>Damage</s>"},{"type":"status","icon":"ir_bash","frame":true,"text":"2d6 <c=#aaaaaa>Slashing</c>","px":24},{"type":"section","tint":"#ffffff10","blocks":[{"type":"status","icon":"ife_cleave","text":"Weapon Enchantment <c=#aaaaaa>+1</c>","px":22}]},{"type":"text","text":"<icon=ife_alertness> Proficiency with this weapon type unlocks:"},{"type":"icons","frame":true,"icons":["isk_heal","isk_search","isk_spot","isk_listen"],"px":32},{"type":"divider"},{"type":"text","size":0.85,"dim":true,"italic":true,"text":"Strong castle-forged steel surmounts a grip of sturdy leather; this immense sword is capable of disembowelling giants in a single swipe."},{"type":"footer","size":0.85,"left":"<icon=ir_bash> Greatsword","right":"2.7 <icon=is_bless>  211 <icon=ir_buy>","tint":"#3b2a5a99"}]},{"width":300,"tab":"Inspect","tabcolor":"#000000b0","bg":{"from":"#1c2a20f4","to":"#101a14f4","dir":"v"},"border":"#5a8c6a","images":[{"src":"ir_bash","w":72,"h":72,"at":"tr","dx":14,"dy":-20}],"blocks":[{"type":"text","size":1.3,"text":"Trepan","color":"#46d17a"},{"type":"text","size":0.85,"dim":true,"text":"Uncommon"},{"type":"text","size":1.6,"text":"4~9 <s=0.85>Damage</s>"},{"type":"status","icon":"ir_bash","frame":true,"text":"1d6+3 <c=#aaaaaa>Piercing</c>","px":24},{"type":"section","tint":"#ffffff10","blocks":[{"type":"status","icon":"ife_cleave","text":"Weapon Enchantment <c=#aaaaaa>+1</c>","px":22}]},{"type":"text","text":"<icon=ife_alertness> Proficiency with this weapon type unlocks:"},{"type":"icons","frame":true,"icons":["isk_heal","isk_search","isk_spot"],"px":32},{"type":"divider"},{"type":"text","size":0.85,"dim":true,"italic":true,"text":"The soothing jade handle stands in stark contrast to the trepan's gruesome tip, a reminder of its intended use."},{"type":"footer","size":0.85,"left":"<icon=ir_bash> Shortsword","right":"0.9 <icon=is_bless>  117 <icon=ir_buy>","tint":"#3b2a5a99"}]}]
card.cell=[{"width":220,"bg":"#101418f2","blocks":[{"type":"text","size":1.3,"text":"A list row","color":"#ffd24a"},{"type":"text","text":"Every row without a card of its own shows this one."}]}]
card.cell#2=[{"width":220,"bg":"#101418f2","blocks":[{"type":"text","size":1.3,"text":"Row 2","color":"#ffd24a"},{"type":"text","text":"Row 2 has its own card, which beats the shared one."}]}]
