// cx_fsfbpostpr's `frame` pass: a 64x64 grain that changes every frame. Hosted in cx_pass_cs.
// A fixture for check-shaders.py; it ships nowhere.
layout(local_size_x = 8, local_size_y = 8) in;
layout(r8) uniform writeonly image2D cxGrain;
uniform int cxFrame;
void main()
{
    ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(at, imageSize(cxGrain)))) return;
    float n = fract(sin(dot(vec3(at, cxFrame & 1023), vec3(12.9898, 78.233, 37.719))) * 43758.5453);
    imageStore(cxGrain, at, vec4(n));
}
