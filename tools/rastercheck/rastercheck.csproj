<Project Sdk="Microsoft.NET.Sdk">
  <!-- Alloy's TGA decoder and DDS unpack, the files the game compiles, run over real files: check.py drives it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../managed/Alloy/RasterReader.Decode.cs" />
    <Compile Include="../../managed/Alloy/DdsReader.Parse.cs" />
    <Compile Include="../../managed/Alloy/BcnDecode.cs" />
    <Compile Include="../../managed/Alloy/Core/Texel.cs" />
  </ItemGroup>
</Project>
