<Project Sdk="Microsoft.NET.Sdk">
  <!-- CX-112: Alloy's MDL parser (managed/Alloy/Mdl/) run over the real corpora off-device. JIT, not AOT. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>mdlcheck</AssemblyName>
    <RootNamespace>CX.MdlCheck</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="KeyBif.cs" />
    <Compile Include="../../managed/Alloy/Mdl/ModelDef.cs" />
    <Compile Include="../../managed/Alloy/Mdl/MdlParser.cs" />
    <Compile Include="../../managed/Alloy/Mdl/MdlBinary.cs" />
    <Compile Include="../../managed/Alloy/Mdl/MdlAscii.cs" />
    <Compile Include="../../managed/Alloy/Mdl/MdlTokens.cs" />
    <Compile Include="../../managed/Alloy/Mdl/MdlPost.cs" />
    <Compile Include="../../managed/Alloy/Mdl/MdlSelfCheck.cs" />
    <Compile Include="../../managed/Alloy/Mdl/MdlBinaryPayload.cs" />
    <Compile Include="../../managed/Alloy/Physics/*.cs" Exclude="../../managed/Alloy/Physics/*SelfCheck*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
