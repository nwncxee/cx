<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AssemblyName>cx_managed</AssemblyName>
    <!-- `dotnet publish -r win-x64` cross-compiles the .dll on Linux (unsupported by
         Microsoft, works): see the win-x64 block below and build-win.sh. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Keep the symbol table in the .so: a NativeAOT crash report is a list of module offsets, and
         without this addr2line resolves every one of them to the nearest EXPORT (i.e. CxInit) and the
         backtrace says nothing. Costs size in a file nobody ships to players. -->
    <StripSymbols>false</StripSymbols>
    <!-- The live scheduler trace showed ".NET Server GC" threads preempting the game's main thread 43 times in
         8s: server GC keeps one GC thread per core and wakes them all on every collection. Workstation and
         non-concurrent: the only GC work happens on the thread that allocates, and nothing of ours allocates
         inside a frame (the period lines are the exception, one gen0 per ~6s). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- Keep our own assembly whole: the service host discovers services by
       reflection, so their constructors must survive trimming. Trimming a tiny
       extender saves nothing; rooting it removes all reflection/AOT fragility. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="cx_managed" />
  </ItemGroup>

  <!-- SMAA's precomputed area/search tables (third_party/smaa/LICENSE.txt), read once per context, and the
       UI typeface (third_party/dejavu/LICENSE.txt). All three ride inside the image so the shipped artifact
       is one file per platform and the glyphs are the same on every machine. -->
  <ItemGroup>
    <EmbeddedResource Include="Alloy/Pass/SmaaArea.bin" LogicalName="SmaaArea" />
    <EmbeddedResource Include="Alloy/Pass/SmaaSearch.bin" LogicalName="SmaaSearch" />
    <EmbeddedResource Include="../third_party/dejavu/DejaVuSans.ttf" LogicalName="DejaVuSans" />
    <!-- The charter self-check's real curved placeable (plc_x0_jar's jar_base trimesh), 4 KiB gzipped. WithCulture:
         MSBuild on Windows reads the ".bin" in the name as the culture "bin" and ships it in a satellite. -->
    <EmbeddedResource Include="Alloy/ChartFixture.bin.gz" LogicalName="ChartFixture" WithCulture="false" />
  </ItemGroup>

  <!-- The client builds CX is measured against (ClientBuilds): a new client build is a new file here,
       written by tools/update/, read through the "builds/" resource prefix. -->
  <ItemGroup>
    <EmbeddedResource Include="Framework/Builds/*.tsv" LogicalName="builds/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- #707: the Alloy pipeline's GLSL, one .glsl per stage or library, read through ShaderSource by file
       name (which is what an `#include "Other.glsl"` line inside one names too). Embedded rather than
       shipped as content (ADR 0012): a stage is overridden as a .shd through the resource chain, never by
       editing what the extender compiles. -->
  <ItemGroup>
    <EmbeddedResource Include="Alloy/Shaders/*.glsl" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- funchook is linked IN, not shipped beside us: DirectPInvoke turns the DllImport("funchook") calls in
       HookService into direct calls against the static library the build scripts stage here. -->
  <ItemGroup>
    <DirectPInvoke Include="funchook" />
    <!-- distorm is funchook's bundled length-disassembler; the shared build hid it, the static one does not. -->
    <NativeLibrary Condition="'$(RuntimeIdentifier)' != 'win-x64'" Include="$(MSBuildThisFileDirectory)../build/libfunchook.a" />
    <NativeLibrary Condition="'$(RuntimeIdentifier)' != 'win-x64'" Include="$(MSBuildThisFileDirectory)../build/libdistorm.a" />
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'win-x64'" Include="$(MSBuildThisFileDirectory)../build/funchook.lib" />
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'win-x64'" Include="$(MSBuildThisFileDirectory)../build/distorm.lib" />
    <!-- funchook's Windows page walk uses GetMappedFileNameA; the shared build pulled this in itself. -->
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'win-x64'" Include="psapi.lib" />
    <!-- #673: the vendored xatlas (native/xatlas) behind native/cxatlas.cpp's two C entry points, linked in the
         same way. Compiled single-threaded and without exceptions/RTTI, so it needs no C++ runtime. -->
    <DirectPInvoke Include="cxatlas" />
    <NativeLibrary Condition="'$(RuntimeIdentifier)' != 'win-x64'" Include="$(MSBuildThisFileDirectory)../build/libcxatlas.a" />
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'win-x64'" Include="$(MSBuildThisFileDirectory)../build/cxatlas.lib" />
    <!-- CX-57: the Steam Audio mixer (native/cxaudio.cpp). Steam Audio and OpenAL themselves are NOT linked: the
         core resolves them at run time from the libraries shipped beside us, so a missing one stands sound down
         instead of the whole extender. -->
    <DirectPInvoke Include="cxaudio" />
    <NativeLibrary Condition="'$(RuntimeIdentifier)' != 'win-x64'" Include="$(MSBuildThisFileDirectory)../build/libcxaudio.a" />
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'win-x64'" Include="$(MSBuildThisFileDirectory)../build/cxaudio.lib" />
    <!-- native/cxthunk.c: C wrappers for engine functions that throw C++ exceptions, so no managed frame is unwound. -->
    <DirectPInvoke Include="cxthunk" />
    <NativeLibrary Condition="'$(RuntimeIdentifier)' != 'win-x64'" Include="$(MSBuildThisFileDirectory)../build/libcxthunk.a" />
    <NativeLibrary Condition="'$(RuntimeIdentifier)' == 'win-x64'" Include="$(MSBuildThisFileDirectory)../build/cxthunk_win.obj" />
    <!-- The pinned-OpenAL redirect lives in the proxy half (native/bootstrap_win.c); Windows only. -->
    <DirectPInvoke Condition="'$(RuntimeIdentifier)' == 'win-x64'" Include="cxboot" />
  </ItemGroup>

  <!-- Windows cross-compile (NativeAOT #48). Lifts the SDK's cross-OS refusal; ILC emits a
       COFF .obj on Linux and lld-link links it (build-win.sh passes CppLinker, which the
       ILCompiler targets would otherwise reset to `link`). WinLib is a lowercase symlink
       mirror of the Win10 SDK um/ucrt + MSVC x64 libs (lld-link is case-sensitive here). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <!-- Cross-host only: a native Windows build (build-win-native.sh, the release path) lets ILC find
       link.exe itself; with IlcUseEnvironmentalTools a bare `link` resolves to Git Bash's coreutils link. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(OS)' != 'Windows_NT'">
    <DisableUnsupportedError>true</DisableUnsupportedError>
    <IlcUseEnvironmentalTools>true</IlcUseEnvironmentalTools>
    <EnableSourceLink>false</EnableSourceLink>
    <WinLib Condition="'$(WinLib)' == ''">$(MSBuildThisFileDirectory)../build/winsdk/lib</WinLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <AdditionalNativeLibraryDirectories Condition="'$(WinLib)' != ''" Include="$(WinLib)" />
    <!-- The proxy half of version.dll: the version.dll export forwarders (as .drectve directives, which is
         the only form that survives with backslashes intact) and the CRT initializer that starts us. -->
    <NativeLibrary Include="$(MSBuildThisFileDirectory)../build/bootstrap_win.obj" />
  </ItemGroup>

</Project>
