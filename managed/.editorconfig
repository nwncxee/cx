# Compiler rules that stop the build (ADR 0031).
[*.cs]
# A call listed in BannedSymbols.txt.
dotnet_diagnostic.RS0030.severity = error
# A pointer plus an offset outside managed/Framework/.
dotnet_diagnostic.CX0001.severity = error
# A fixed-size buffer.
dotnet_diagnostic.CX0002.severity = error
# GL outside managed/Graphics/ and managed/Alloy/.
dotnet_diagnostic.CX0003.severity = error
# A queue submit, fence or semaphore wait outside VkBackend.Sync.cs.
dotnet_diagnostic.CX0004.severity = error
# A Vulkan or VMA entry point outside managed/Graphics/.
dotnet_diagnostic.CX0005.severity = error
